# NVIDIA NIM API Key (required for Nemotron 3 Super / reasoning LLM)
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: override model if desired
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Flask session encryption key
SECRET_KEY=your-secure-random-secret-key-for-sessions

# Server Port
PORT=5000

# SQLite Database Location
DATABASE_PATH=data/app.db
